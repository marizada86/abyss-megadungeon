extends RefCounted
const Flow := preload("res://core/chapter_flow.gd")
const HQ := preload("res://core/hq_catalog.gd")

func run() -> Array:
	var errors: Array[String] = []
	var p := Profile.new()
	if not p.stage_unlocked("docas") or p.stage_unlocked("dagruve") or p.stage_unlocked("domwieck"): errors.append("fresh permissions")
	Flow.prepare_start(p.data, "docas")
	if p.data.campaign_progress.pending_hqs.size() != 1: errors.append("first presentation")
	Flow.cursor(p.data, "hqn_01", 3)
	var reload := Profile.new(p.data.duplicate(true))
	if reload.data.campaign_progress.pending_hqs[0].panel_index != 3: errors.append("resume cursor")
	Flow.resolve(reload.data, "hqn_01", false)
	if reload.data.hqs_seen.has("hqn_01") or reload.coins() != 0: errors.append("dismiss reward")
	Flow.prepare_start(reload.data, "docas")
	if not reload.data.campaign_progress.pending_hqs.is_empty(): errors.append("dismiss repeat")
	Flow.clear_stage(reload.data, "docas")
	Flow.clear_stage(reload.data, "docas")
	if reload.data.campaign_progress.pending_hqs.map(func(row): return row.id) != ["hqn_02", "hqn_15", "hqn_16", "hqn_17"]: errors.append("ordered unique queue")
	if not reload.stage_unlocked("reino_abissal") or reload.stage_unlocked("domwieck"): errors.append("second permission")
	if not HQ.is_unlocked(reload.data, "hqn_14") or HQ.is_unlocked(reload.data, "hqn_11"): errors.append("diary selection")
	Flow.clear_stage(reload.data, "reino_abissal")
	if not reload.stage_unlocked("domwieck"): errors.append("third permission")
	Flow.clear_stage(reload.data, "domwieck")
	if reload.data.campaign_progress.milestones.has("chapter1_closed"): errors.append("premature closure")
	Flow.resolve(reload.data, "hqn_03", false)
	if not reload.data.campaign_progress.milestones.has("chapter1_closed"): errors.append("closure missing")
	var legacy := Profile.new({"coins": 123, "cleared": {"dagruve": true}, "achievements": {"aluris": true}, "custom": {"future": 42}})
	if not legacy.stage_unlocked("shedaklah") or not legacy.stage_unlocked("dagruve") or not legacy.stage_unlocked("reino_abissal"): errors.append("legacy permissions")
	if legacy.stage_unlocked("domwieck") or legacy.data.campaign_progress.milestones.has("chapter1_closed"): errors.append("fabricated progress")
	if not HQ.is_unlocked(legacy.data, "hqn_12"): errors.append("legacy archive")
	var twice := Profile.new(legacy.data.duplicate(true))
	if twice.coins() != 123 or twice.data.custom.future != 42 or twice.data.campaign_progress != legacy.data.campaign_progress: errors.append("migration idempotence")
	var future_dagruve := Profile.new()
	future_dagruve.data.cleared.dagruve = true
	var reloaded := Profile.new(future_dagruve.data)
	if reloaded.data.cleared.has("docas"): errors.append("stage split leaked into new profile")
	return errors
